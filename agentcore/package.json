{
  "name": "super-agent-agentcore-runner",
  "version": "1.0.0",
  "type": "module",
  "description": "AgentCore Runtime container running Codex app-server on Amazon Bedrock",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.205.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "brace-expansion": "2.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
