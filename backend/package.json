{
  "name": "backend",
  "version": "1.0.0",
  "description": "Unified TypeScript backend for Super Agent Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:codex:e2e": "tsx scripts/codex-app-server-smoke.ts",
    "test:codex:functional": "tsx scripts/codex-functional-audit.ts",
    "test:agentcore:codex:e2e": "tsx scripts/agentcore-codex-smoke.ts",
    "test:agentcore:codex:functional": "tsx scripts/agentcore-codex-functional-audit.ts",
    "codex:schema:generate": "tsx scripts/codex-schema.ts",
    "codex:schema:check": "tsx scripts/codex-schema.ts --check",
    "workspace:migrate:codex": "tsx scripts/migrate-workspaces-to-codex.ts",
    "workspace:normalize-agent-skills": "tsx scripts/normalize-agent-skill-context.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy"
  },
  "keywords": [
    "super-agent",
    "backend",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.37",
    "@aws-sdk/client-bedrock": "^3.1110.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1110.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/js-yaml": "^4.0.9",
    "@wecom/aibot-node-sdk": "^1.0.6",
    "archiver": "^7.0.1",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "cron-parser": "^4.9.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.3",
    "langfuse": "^3.38.20",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "prisma": "^7.9.1",
    "tsx": "^4.21.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@protobufjs/utf8@<=1.1.0": "1.1.2",
    "@fastify/ajv-compiler": {
      "ajv": "8.20.0"
    },
    "@modelcontextprotocol/sdk": {
      "ajv": "8.20.0"
    },
    "@prisma/streams-local": {
      "ajv": "8.20.0"
    },
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "fast-json-stringify": {
      "ajv": "8.20.0"
    },
    "flatted@<=3.4.1": "3.4.4",
    "hono@<=4.12.33": "4.13.2",
    "lodash@<=4.17.23": "4.18.1",
    "minimatch@<3.1.4": "3.1.5",
    "minimatch@>=5.0.0 <5.1.8": "5.1.9",
    "minimatch@>=9.0.0 <9.0.7": "9.0.9",
    "protobufjs@<=7.6.4": "7.6.5",
    "ws@>=8.0.0 <8.21.0": "8.21.3",
    "yaml@>=2.0.0 <2.8.3": "2.9.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
